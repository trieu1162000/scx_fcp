#!/usr/bin/env bash
# Central environment configuration for scx_fcp build, launch, and reproduction.
# Override any variable inline (e.g. CPUS=16 TOPO=sym ./artifact/pipeline.sh launch).

_CFG_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
_REPO_ROOT=$(cd "$_CFG_DIR/.." && pwd)

# 1. Platform & ADB Transport
export PLATFORM=${PLATFORM:-x86_64}
export SCX_ROOT=${SCX_ROOT:-$HOME/workspace/scx}
export CF_HOME=${CF_HOME:-$HOME/workspace/aosp_research/cf}
export ADB=${ADB:-adb}

if [ "$PLATFORM" = arm64 ]; then
  export TARGET=aarch64-unknown-linux-gnu
  export ANDROID_ADB_SERVER_PORT=${ANDROID_ADB_SERVER_PORT:-5037}
  export SERIAL=${SERIAL:-1feeaa2f}
else
  export TARGET=x86_64-unknown-linux-gnu
  export ANDROID_ADB_SERVER_PORT=${ANDROID_ADB_SERVER_PORT:-5038}
  export SERIAL=${SERIAL:-127.0.0.1:6520}
fi

# 2. Build & Workload Directories
export BIN_DIR=${BIN_DIR:-$_CFG_DIR/build/bin/$PLATFORM}
export WORKLOADS_DIR=${WORKLOADS_DIR:-$_CFG_DIR/workloads/$PLATFORM}
export BUILD_BASELINES=${BUILD_BASELINES:-1}
export REMOTE_DIR=${REMOTE_DIR:-/data/local/tmp/scx}

# 3. Optional Custom Kernel / Initramfs / AOSP Output
export KERNEL=${KERNEL:-}
export INITRAMFS=${INITRAMFS:-}
export AOSP_OUT=${AOSP_OUT:-}

# 4. Topology & Capacity Shaping (Cuttlefish: dl = SCHED_DEADLINE 446:1024, sym = 1024:1024)
export CPUS=${CPUS:-32}
export MEMORY_MB=${MEMORY_MB:-8192}
export TOPO=${TOPO:-dl}
export PROXY_EXEC=${PROXY_EXEC:-0}
export DL_RUNTIME_NS=${DL_RUNTIME_NS:-892000}
export DL_PERIOD_NS=${DL_PERIOD_NS:-2000000}

# 5. Campaign Defaults
if [ "$PLATFORM" = arm64 ]; then
  export POLICIES=${POLICIES:-eevdf,scx_p2dq,scx_lavd,scx_fcp_behavioral,scx_fcp}
  export BG_WORKERS=${BG_WORKERS:-6}
else
  export POLICIES=${POLICIES:-eevdf,eevdf_proxy_exec,scx_p2dq,scx_lavd,scx_fcp_behavioral,scx_fcp}
  export BG_WORKERS=${BG_WORKERS:-$((3 * CPUS / 4))}
fi

export RUNS=${RUNS:-10}
export MAX_ATTEMPTS=${MAX_ATTEMPTS:-3}
export MICRO_CPUS_LIST=${MICRO_CPUS_LIST:-"4 8 16 32"}
export MICRO_TOPOS=${MICRO_TOPOS:-"sym dl"}
export MICRO_FRAMES=${MICRO_FRAMES:-100}
export MICRO_HZ=${MICRO_HZ:-90}
export MICRO_STAGES=${MICRO_STAGES:-4}
export MICRO_STAGE_US=${MICRO_STAGE_US:-1800}
export OVERHEAD_POLICIES=${OVERHEAD_POLICIES:-scx_p2dq,scx_lavd,scx_fcp_behavioral,scx_fcp}
export ABLATION_POLICIES=${ABLATION_POLICIES:-scx_fcp_notoken,scx_fcp_nofanout,scx_fcp_behavioral,scx_fcp}
