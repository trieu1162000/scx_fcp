#!/usr/bin/env bash
# Central environment configuration for scx_fcp build, Cuttlefish launch, and
# evaluation pipelines.
#
# Edit the defaults below once for your host environment, or override any
# variable on the command line (e.g. CPUS=16 ./artifact/pipeline.sh launch).

_CFG_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
_REPO_ROOT=$(cd "$_CFG_DIR/.." && pwd)

# 1. Host & Workspace Paths
export PLATFORM=${PLATFORM:-x86_64}
export SCX_ROOT=${SCX_ROOT:-$HOME/workspace/scx}
export CF_HOME=${CF_HOME:-$HOME/workspace/aosp_research/cf}
export ADB=${ADB:-adb}
export SERIAL=${SERIAL:-127.0.0.1:6520}

# 2. Build & Workload Artifact Directories
# Private .env files may override these. Select architecture-specific defaults
# from PLATFORM when they do not.
if [ "$PLATFORM" = arm64 ]; then
  export TARGET=aarch64-unknown-linux-gnu
else
  export TARGET=x86_64-unknown-linux-gnu
fi
export BIN_DIR=${BIN_DIR:-$_CFG_DIR/build/bin/$PLATFORM}
export WORKLOADS_DIR=${WORKLOADS_DIR:-$_CFG_DIR/workloads/$PLATFORM}
export BUILD_BASELINES=${BUILD_BASELINES:-1}

# 3. Optional Custom Kernel / Initramfs
# Default kernel of latest cf image release by Android is 6.12
# Modify paths if using custom kernel, eg. 6.18 or above
export KERNEL=${KERNEL:-}
export INITRAMFS=${INITRAMFS:-}

# 4. Optional when not building the apks from AOSP source tree
export ANDROID_HOME=${ANDROID_HOME:-}
export JAVA_HOME=${JAVA_HOME:-}
export AOSP_TESTS=${AOSP_TESTS:-$HOME/work/aosp-tests}
# Optional AOSP product output directory for copying workload APKs.
# Replace as per your src dir and device
export AOSP_SRC=${AOSP_SRC:-android_src_dir}
export TARGET_PRODUCT=${TARGET_PRODUCT:-your_device}
export AOSP_OUT=${AOSP_OUT:-$AOSP_SRC/out/target/product/$TARGET_PRODUCT}

# 5. Cuttlefish Guest & Topology Configuration
export CPUS=${CPUS:-32}
export MEMORY_MB=${MEMORY_MB:-8192}
export TOPO=${TOPO:-asym}
export PROXY_EXEC=${PROXY_EXEC:-0}

# Cuttlefish reports the same symmetric cpu_capacity sysfs for sym and dl.
# Convert the host topology into the explicit scx_fcp big-CPU list:
#   sym       all CPUs are 1024
#   dl/asym   upper half is 1024, lower half is 446
# ARM64 devices keep their real tri-cluster capacity table.
fcp_big_cpus_list() {
    local topo=${1:-${TOPO:-}} cpus=${2:-${CPUS:-}} platform=${3:-${PLATFORM:-x86_64}}
    local first last

    [ "$platform" = "x86_64" ] || return 0
    case "$topo" in
        sym)        first=0; last=$((cpus - 1)) ;;
        dl|asym)    first=$((cpus / 2)); last=$((cpus - 1)) ;;
        *)          return 0 ;;
    esac
    [ "$cpus" -ge 2 ] 2>/dev/null || return 1
    seq -s, "$first" "$last"
}

fcp_capacity_args() {
    local ids
    ids=$(fcp_big_cpus_list "$@") || return 1
    [ -n "$ids" ] && printf -- '--big-cpus %s' "$ids"
}

# 6. Optional exact-reference checks. Leave empty for a source build or an
# alternate image; set them to reproduce the released artifact exactly.
export EXPECTED_KERNEL=${EXPECTED_KERNEL:-}
export EXPECTED_NPROC=${EXPECTED_NPROC:-}
export EXPECTED_SDK=${EXPECTED_SDK:-}
export EXPECTED_BUILD=${EXPECTED_BUILD:-}
export EXPECTED_SELINUX=${EXPECTED_SELINUX:-Permissive}
export EXPECTED_APP_SHA256=${EXPECTED_APP_SHA256:-}
export FIXED_UI_APK_SHA=${FIXED_UI_APK_SHA:-}

# 7. Evaluation Matrix Defaults
if [ "$PLATFORM" = arm64 ]; then
  export POLICIES=${POLICIES:-eevdf,scx_fcp,scx_fcp_v_a_depth3_tgid1ms,scx_p2dq_pelt_off,scx_lavd}
else
  export POLICIES=${POLICIES:-eevdf,scx_fcp,scx_fcp_v_a_depth3_tgid1ms,scx_p2dq_pelt_off,scx_lavd,eevdf_proxy_exec}
fi
export RUNS=${RUNS:-10}
export RUN_COUNT=${RUN_COUNT:-4}
export WARMUP_ITERATIONS=${WARMUP_ITERATIONS:-1}
export JANK_TESTS=${JANK_TESTS:-0,1,2,3,4,5,6,7}
export UI_TESTS=${UI_TESTS:-bitmap-upload,shadow-grid-list,inflating-list,slow-bind-recycler,trivial-recycler,layout-cache-low}
export UI_ALLOW_INVALID=${UI_ALLOW_INVALID:-none}
export BPF_STATS=${BPF_STATS:-0}

# 8. eBPF Overhead Block
# Overhead uses its own protocol; timing runs keep BPF_STATS=0.
export OVERHEAD_REPS=${OVERHEAD_REPS:-10}
export OVERHEAD_SUITE=${OVERHEAD_SUITE:-all}
export OVERHEAD_BENCH_IDS=${OVERHEAD_BENCH_IDS:-0,1,2,3,4,5,6,7}
export OVERHEAD_RUN_COUNT=${OVERHEAD_RUN_COUNT:-3}
export OVERHEAD_WARMUP_ITERATIONS=${OVERHEAD_WARMUP_ITERATIONS:-0}
export OVERHEAD_POLICIES=${OVERHEAD_POLICIES:-scx_lavd,scx_p2dq_pelt_off,scx_fcp_behavioral,scx_fcp}
export OVERHEAD_UI_TESTS=${OVERHEAD_UI_TESTS:-bitmap-upload,shadow-grid-list,inflating-list,slow-bind-recycler,trivial-recycler,layout-cache-low}
export OVERHEAD_OUT=${OVERHEAD_OUT:-$_CFG_DIR/results/bpf_overhead/$(date +%F)/cf-${CPUS}vcpu-${TOPO}}

# 9. Synthetic microbenchmark scaling (fcp_frame_bench, Cuttlefish)
export MICRO_SUITE=${MICRO_SUITE:-fcp}
export MICRO_CPUS_LIST=${MICRO_CPUS_LIST:-"4 8 16 32"}
export MICRO_TOPOS=${MICRO_TOPOS:-"sym dl"}
export MICRO_RUNS=${MICRO_RUNS:-10}
export MICRO_FRAMES=${MICRO_FRAMES:-60}
export MICRO_HZ=${MICRO_HZ:-90}
export MICRO_STAGES=${MICRO_STAGES:-4}
export MICRO_STAGE_US=${MICRO_STAGE_US:-1800}
export MICRO_POLICIES=${MICRO_POLICIES:-"eevdf scx_p2dq_pelt_off scx_lavd scx_fcp scx_fcp_behavioral"}
export MICRO_RUN_PROXY=${MICRO_RUN_PROXY:-1}
export MICRO_ALLOW_OVERSIZED=${MICRO_ALLOW_OVERSIZED:-0}
export MICRO_SCHBENCH_THREADS=${MICRO_SCHBENCH_THREADS:-}
export MICRO_SCHBENCH_ARGS=${MICRO_SCHBENCH_ARGS:-"-m 1 -r 30 -w 5 -j -"}
export MICRO_OUT=${MICRO_OUT:-$_CFG_DIR/results/micro/$(date +%Y%m%d-%H%M%S)}
