#!/usr/bin/env bash
# Central environment configuration for scx_fcp build, Cuttlefish launch, and
# evaluation pipelines.
#
# Edit the defaults below once for your host environment, or override any
# variable on the command line (e.g. CPUS=16 ./artifact/pipeline.sh launch).

_CFG_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
_REPO_ROOT=$(cd "$_CFG_DIR/.." && pwd)

# 1. Host & Workspace Paths
export SCX_ROOT=${SCX_ROOT:-$HOME/workspace/scx}
export CF_HOME=${CF_HOME:-$HOME/workspace/aosp_research/cf}
export ADB=${ADB:-adb}
export SERIAL=${SERIAL:-127.0.0.1:6520}

# 2. Build & Workload Artifact Directories
export BIN_DIR=${BIN_DIR:-$_CFG_DIR/build/bin}
export WORKLOADS_DIR=${WORKLOADS_DIR:-$_CFG_DIR/workloads}
export BUILD_BASELINES=${BUILD_BASELINES:-1}

# 3. Optional Custom Kernel / Initramfs
# Default kernel of latest cf image release by Android is 6.12
# Modify paths if using custom kernel, eg. 6.18 or above
export KERNEL=${KERNEL:-}
export INITRAMFS=${INITRAMFS:-}

# 4. Optional when not building the apks from AOSP source tree
export ANDROID_HOME=${ANDROID_HOME:-}
export JAVA_HOME=${JAVA_HOME:-}
export AOSP_TESTS=${AOSP_TESTS:-$HOME/work/aosp-tests}
# Optional AOSP product output directory for copying workload APKs.
# Replace as per your src dir and device
export AOSP_SRC=${AOSP_SRC:-android_src_dir}
export TARGET_PRODUCT=${TARGET_PRODUCT:-your_device}
export AOSP_OUT=${AOSP_OUT:-$AOSP_SRC/out/target/product/$TARGET_PRODUCT}

# 5. Cuttlefish Guest & Topology Configuration
export CPUS=${CPUS:-32}
export MEMORY_MB=${MEMORY_MB:-8192}
export TOPO=${TOPO:-asym}
export PROXY_EXEC=${PROXY_EXEC:-0}

# 6. Optional exact-reference checks. Leave empty for a source build or an
# alternate image; set them to reproduce the released artifact exactly.
export EXPECTED_KERNEL=${EXPECTED_KERNEL:-}
export EXPECTED_NPROC=${EXPECTED_NPROC:-}
export EXPECTED_SDK=${EXPECTED_SDK:-}
export EXPECTED_BUILD=${EXPECTED_BUILD:-}
export EXPECTED_SELINUX=${EXPECTED_SELINUX:-Permissive}
export EXPECTED_APP_SHA256=${EXPECTED_APP_SHA256:-}
export FIXED_UI_APK_SHA=${FIXED_UI_APK_SHA:-}

# 7. Evaluation Matrix Defaults
export POLICIES=${POLICIES:-eevdf,scx_fcp,scx_fcp_v_a_depth3_tgid1ms,scx_p2dq_pelt_off,scx_lavd,eevdf_proxy_exec}
export RUNS=${RUNS:-10}
export RUN_COUNT=${RUN_COUNT:-4}
export WARMUP_ITERATIONS=${WARMUP_ITERATIONS:-1}
export JANK_TESTS=${JANK_TESTS:-0,1,2,3,4,5,6,7}
export UI_TESTS=${UI_TESTS:-bitmap-upload,shadow-grid-list,inflating-list,slow-bind-recycler,trivial-recycler,layout-cache-low}
export UI_ALLOW_INVALID=${UI_ALLOW_INVALID:-none}
export BPF_STATS=${BPF_STATS:-0}
